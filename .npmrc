omit-lockfile-registry-resolved=true
# CI's registry proxy sets replace-registry-host=always in the user-level npmrc.
# That rewrites the host of every lockfile "resolved" URL, including non-registry
# tarballs (tree-sitter-kotlin is a GitHub archive), which the proxy then 404s.
# Only rewrite registry hosts; registry deps carry no resolved URL here anyway.
replace-registry-host=npmjs
